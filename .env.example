# Optional: the starter runs without a database or external API credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional map tile provider. Preserve the provider's attribution requirements.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Set a matching attribution string if you change the tile provider.
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# Fill these only when the Supabase integration is implemented.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials belong in .env.local, never in Git or NEXT_PUBLIC_*.
# SUPABASE_SECRET_KEY=
# TMDB_READ_ACCESS_TOKEN=
